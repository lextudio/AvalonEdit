<Project Sdk="LibreWPF.Sdk">
  <!-- Cross-platform (ProGPU/macOS) adaptation of the upstream AvalonEdit master csproj:
       single net10.0-windows target via ProGPU.Wpf.Sdk instead of the upstream
       net8.0-windows;net10.0-windows;net462 multi-target, WinForms dropped (the 3 WinForms usages
       in TextArea/InsightWindow/CompletionWindowBase are patched out - see the "stop caring about
       WinForms" comments there), and SourceLink removed (no CI/package publishing here). Resource/
       EmbeddedResource item groups are kept verbatim from upstream master. -->
  <PropertyGroup>
    <!-- Keep this independently versioned fork insulated when checked out below OpenDevelop. -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ICSharpCode.AvalonEdit</RootNamespace>
    <AssemblyName>ICSharpCode.AvalonEdit</AssemblyName>
    <!-- Preserve the assembly identity; the package itself is specific to LibreWPF. -->
    <PackageId>ICSharpCode.AvalonEdit.LibreWPF</PackageId>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>ICSharpCode.AvalonEdit.snk</AssemblyOriginatorKeyFile>
    <Company>ic#code</Company>
    <Copyright>2000-2025 AlphaSierraPapa for the SharpDevelop Team</Copyright>
    <Description>AvalonEdit is the WPF-based text editor used in SharpDevelop.</Description>
    <RepositoryUrl>https://github.com/lextudio/AvalonEdit</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- The public upstream version is retained by request, while this LibreWPF fork
         intentionally depends on the LibreWPF preview closure. -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <Version>6.3.1.120</Version>
    <AssemblyVersion>6.3.1.120</AssemblyVersion>
    <FileVersion>6.3.1.120</FileVersion>
    <DefineConstants>TRACE</DefineConstants>
    <UseNuGetPackages>true</UseNuGetPackages>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseNuGetPackages)' == 'true'">
    <!-- Cross-platform IME (macOS NSTextInputClient / Linux IBus) support, consumed by
         Editing/ImeSupport.cs. On real Windows the existing imm32 P/Invoke path is unchanged. -->
    <PackageReference Include="LeXtudio.UI.Text.Core" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseNuGetPackages)' != 'true'">
    <ProjectReference Include="..\..\..\..\..\TextCore.Uno\src\LeXtudio.UI.Text.Core\LeXtudio.UI.Text.Core.csproj" />

  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Remove="Search\next.png" />
    <None Remove="Search\prev.png" />
    <None Remove="themes\RightArrow.cur" />
    <Resource Include="Search\next.png" />
    <Resource Include="Search\prev.png" />
    <Resource Include="themes\RightArrow.cur" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Highlighting\Resources\*" />
    <EmbeddedResource Include="Highlighting\Resources\*" />
    <EmbeddedResource Remove="Highlighting\Resources\Resources.cs" />
    <Resource Include="Highlighting\Resources\Resources.cs" />
  </ItemGroup>
</Project>
